  "components": {
    "schemas": {
      "Step": {
        "required": ["type"],
        "type": "object",
        "properties": {
          "stepOrder": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "type": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "type"
        }
      },
      "Workout": {
        "type": "object",
        "properties": {
          "workoutId": {
            "type": "integer",
            "format": "int64",
            "example": 2201
          },
          "ownerId": {
            "type": "integer",
            "format": "int64",
            "example": 232
          },
          "workoutName": {
            "type": "string",
            "example": "Bike Workout"
          },
          "description": {
            "type": "string"
          },
          "updatedDate": {
            "pattern": "2022-08-10T09:47:59\\.031",
            "type": "string",
            "description": "iso 8601 timestamp without GMT offset or 'Z' indicator!",
            "example": "2018-10-23T21:17:53.0"
          },
          "createdDate": {
            "pattern": "2022-08-10T09:47:59\\.031",
            "type": "string",
            "description": "iso 8601 timestamp without GMT offset or 'Z' indicator!",
            "example": "2018-10-23T21:17:53.0"
          },
          "updatedTimeStamp": {
            "type": "integer",
            "format": "int64"
          },
          "createdTimeStamp": {
            "type": "integer",
            "format": "int64"
          },
          "sport": {
            "type": "string",
            "example": "CYCLING",
            "enum": [
              "RUNNING",
              "CYCLING",
              "LAP_SWIMMING",
              "STRENGTH_TRAINING",
              "CARDIO_TRAINING",
              "YOGA",
              "PILATES",
              "GENERIC",
              "HIIT",
              "MULTI_SPORT"
            ]
          },
          "estimatedDurationInSecs": {
            "type": "integer",
            "format": "int32"
          },
          "estimatedDistanceInMeters": {
            "type": "number",
            "format": "double"
          },
          "poolLength": {
            "type": "number",
            "format": "double"
          },
          "poolLengthUnit": {
            "type": "string",
            "enum": ["YARD", "METER"]
          },
          "workoutProvider": {
            "type": "string"
          },
          "workoutSourceId": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WorkoutRepeatStep"
                },
                {
                  "$ref": "#/components/schemas/WorkoutStep"
                }
              ]
            }
          }
        }
      },
      "WorkoutRepeatStep": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/Step"
          },
          {
            "type": "object",
            "properties": {
              "repeatType": {
                "type": "string",
                "enum": [
                  "REPEAT_UNTIL_STEPS_CMPLT",
                  "REPEAT_UNTIL_TIME",
                  "REPEAT_UNTIL_DISTANCE",
                  "REPEAT_UNTIL_CALORIES",
                  "REPEAT_UNTIL_HR_LESS_THAN",
                  "REPEAT_UNTIL_HR_GREATER_THAN",
                  "REPEAT_UNTIL_POWER_LESS_THAN",
                  "REPEAT_UNTIL_POWER_GREATER_THAN",
                  "REPEAT_UNTIL_POWER_LAST_LAP_LESS_THAN",
                  "REPEAT_UNTIL_MAX_POWER_LAST_LAP_LESS_THAN",
                  "REPEAT_UNTIL_TRAINING_PEAKS_TSS"
                ]
              },
              "repeatValue": {
                "type": "number",
                "format": "double"
              },
              "skipLastRestStep": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "WorkoutStep": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/Step"
          },
          {
            "type": "object",
            "properties": {
              "intensity": {
                "type": "string",
                "example": "WARMUP",
                "enum": ["ACTIVE", "REST", "WARMUP", "COOLDOWN", "RECOVERY", "INTERVAL", "MAIN"]
              },
              "description": {
                "type": "string"
              },
              "durationType": {
                "type": "string",
                "example": "CALORIES",
                "enum": [
                  "TIME",
                  "DISTANCE",
                  "HR_LESS_THAN",
                  "HR_GREATER_THAN",
                  "CALORIES",
                  "OPEN",
                  "POWER_LESS_THAN",
                  "POWER_GREATER_THAN",
                  "TRAINING_PEAKS_TSS",
                  "REPETITION_TIME",
                  "REPS",
                  "TIME_AT_VALID_CDA",
                  "FIXED_REST",
                  "FIXED_REPETITION",
                  "REPETITION_SWIM_CSS_OFFSET"
                ]
              },
              "durationValue": {
                "type": "number",
                "format": "double",
                "example": 2
              },
              "durationValueType": {
                "type": "string",
                "enum": ["PERCENT", "MILE", "KILOMETER", "METER", "YARD"]
              },
              "targetType": {
                "type": "string",
                "example": "OPEN",
                "enum": [
                  "SPEED",
                  "HEART_RATE",
                  "OPEN",
                  "CADENCE",
                  "POWER",
                  "GRADE",
                  "RESISTANCE",
                  "POWER_3S",
                  "POWER_10S",
                  "POWER_30S",
                  "POWER_LAP",
                  "SWIM_STROKE",
                  "SPEED_LAP",
                  "HEART_RATE_LAP",
                  "PACE",
                  "PACE_ZONE",
                  "SWIM_INSTRUCTION",
                  "SWIM_CSS_OFFSET"
                ]
              },
              "targetValue": {
                "type": "number",
                "format": "double"
              },
              "targetValueLow": {
                "type": "number",
                "format": "double"
              },
              "targetValueHigh": {
                "type": "number",
                "format": "double"
              },
              "targetValueType": {
                "type": "string",
                "enum": ["PERCENT", "MILE", "KILOMETER", "METER", "YARD"]
              },
              "secondaryTargetType": {
                "type": "string",
                "enum": [
                  "SPEED",
                  "HEART_RATE",
                  "OPEN",
                  "CADENCE",
                  "POWER",
                  "GRADE",
                  "RESISTANCE",
                  "POWER_3S",
                  "POWER_10S",
                  "POWER_30S",
                  "POWER_LAP",
                  "SWIM_STROKE",
                  "SPEED_LAP",
                  "HEART_RATE_LAP",
                  "PACE",
                  "PACE_ZONE",
                  "SWIM_INSTRUCTION",
                  "SWIM_CSS_OFFSET"
                ]
              },
              "secondaryTargetValue": {
                "type": "number",
                "format": "double"
              },
              "secondaryTargetValueLow": {
                "type": "number",
                "format": "double"
              },
              "secondaryTargetValueHigh": {
                "type": "number",
                "format": "double"
              },
              "secondaryTargetValueType": {
                "type": "string",
                "enum": ["PERCENT", "MILE", "KILOMETER", "METER", "YARD"]
              },
              "strokeType": {
                "type": "string",
                "enum": [
                  "BACKSTROKE",
                  "BREASTSTROKE",
                  "DRILL",
                  "BUTTERFLY",
                  "FREESTYLE",
                  "MIXED",
                  "IM",
                  "IM_BY_ROUND",
                  "REVERSE_IM_BY_ROUND",
                  "CHOICE"
                ]
              },
              "drillType": {
                "type": "string",
                "enum": ["KICK", "PULL", "DRILL"]
              },
              "equipmentType": {
                "type": "string",
                "enum": [
                  "NONE",
                  "SWIM_FINS",
                  "SWIM_KICKBOARD",
                  "SWIM_PADDLES",
                  "SWIM_PULL_BUOY",
                  "SWIM_SNORKEL"
                ]
              },
              "exerciseCategory": {
                "type": "string"
              },
              "exerciseName": {
                "type": "string"
              },
              "weightValue": {
                "type": "number",
                "format": "double"
              },
              "weightDisplayUnit": {
                "type": "string",
                "enum": ["OTHER", "KILOGRAM", "POUND"]
              }
            }
          }
        ]
      },
