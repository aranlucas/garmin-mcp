{
  "openapi": "3.1.0",
  "info": {
    "title": "Partner API"
  },
  "servers": [
    {
      "url": "https://apis.garmin.com/partner-gateway",
      "description": "Prod"
    }
  ],
  "paths": {
    "/rest/user/token-exchange": {
      "post": {
        "tags": ["User API"],
        "description": "Exchange existing OAuth 1 tokens for OAuth 2 token. The OAuth2 token will be the 1 to 1 mapping to OAuth1 for a user.",
        "operationId": "exchangeOAuth1For2Token",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthTokenExchangeResp"
                }
              }
            }
          }
        }
      }
    },
    "/rest/user/permissions": {
      "get": {
        "tags": ["User API"],
        "description": "Get permissions granted to the partner by the user.",
        "operationId": "USER_PERMISSIONS",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConsumerPermissions"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          }
        }
      }
    },
    "/rest/user/id": {
      "get": {
        "tags": ["User API"],
        "description": "Get the Connect Developer User ID. This ID will persist across multiple User Access Tokens generated by the same user.",
        "operationId": "USER_ID",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ClientUserId"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiServiceFailure"
                }
              }
            }
          }
        }
      }
    },
    "/rest/user/registration": {
      "delete": {
        "tags": ["User API"],
        "description": "Delete the provided user access token, removing the association between the user and the calling app",
        "operationId": "DEREG",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OAuthTokenExchangeResp": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int32"
          },
          "scope": {
            "type": "string"
          },
          "refresh_token_expires_in": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ClientConsumerPermissions": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "4aacafe82427c251df9c9592d0c06768"
          },
          "summaryId": {
            "type": "string",
            "example": "x153a9f3-5a9478d4-6"
          },
          "permissions": {
            "type": "array",
            "example": "[ACTIVITY_EXPORT, WORKOUT_IMPORT, HEALTH_EXPORT, COURSE_IMPORT, MCT_EXPORT]",
            "items": {
              "type": "string"
            }
          },
          "changeTimeInSeconds": {
            "type": "integer",
            "format": "int32",
            "description": "Unix Epoch Timestamp",
            "example": 1613065860
          }
        }
      },
      "ClientUserId": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "4aacafe82427c251df9c9592d0c06768"
          }
        }
      },
      "ServiceFailure": {
        "properties": {
          "errorType": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "errorId": {
            "type": "string"
          }
        }
      },
      "ApiServiceFailure": {
        "properties": {
          "errorMessage": {
            "type": "string"
          }
        }
      }
    }
  }
}
