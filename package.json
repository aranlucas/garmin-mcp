{
  "name": "garmin-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Garmin Health, Activity, and Training MCP with shared Auth sign-in",
  "keywords": [],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm run build:apps && portless run vite",
    "typegen": "cf workers types",
    "build:apps": "vite build --config vite.apps.config.ts",
    "generate:api": "pnpm --filter garmin-api-codegen generate",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "pnpm run build:apps && vitest run --project worker",
    "test:apps": "pnpm run build:apps && vitest run --project apps",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "build": "pnpm run build:apps && vite build",
    "deploy": "pnpm run build && cf deploy --prebuilt",
    "deploy:preview": "pnpm run build:apps && CLOUDFLARE_PREVIEW_BUILD=true vite build && cf previews deploy --prebuilt",
    "smoke": "vitest run --project smoke",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector@2.11.0 --server-url https://garmin-mcp.aranlucas.workers.dev/mcp",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.18",
    "@garmin/fitsdk": "21.221.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.18",
    "hono": "4.13.17",
    "jose": "^6.2.16",
    "standardwebhooks": "^1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.3.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@e2e-dev/web": "0.15.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "1.0.0-beta.28",
    "e2e": "0.23.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "^1.65.0",
    "portless": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.1.0-dev.20261109.1",
    "vite": "8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
